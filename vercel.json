{
  "routes": [
    { "src": "/link-bio(/.*)?", "dest": "/" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "leonardosantosdavi.com.br" }],
      "dest": "https://link-bio-leonardo.vercel.app/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.leonardosantosdavi.com.br" }],
      "dest": "https://link-bio-leonardo.vercel.app/$1"
    },
    { "handle": "filesystem" }
  ]
}
